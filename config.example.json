      "rcon_password_env": "MC_RCON_3",
      "online_mode": false,
      "tps_command": "spark tps",
      "players_command": "list",
      "tps_source": "auto",
      "spark_file": ".astrbot-spark-tps.txt",
      "tps_mode": "spark"
    },
    {
      "__template_key": "server",
      "id": "server4",
      "name": "服务器 4",
      "directory": "server4",
      "rcon_host": "127.0.0.1",
      "rcon_port": 25578,
      "rcon_password": "",
      "rcon_password_env": "MC_RCON_4",
      "online_mode": false,
      "tps_command": "spark tps",
      "players_command": "list",
      "tps_source": "auto",
      "spark_file": ".astrbot-spark-tps.txt",
      "tps_mode": "spark"
    },
    {
      "__template_key": "server",
      "id": "server5",
      "name": "服务器 5",
      "directory": "server5",
      "rcon_host": "127.0.0.1",
      "rcon_port": 25579,
      "rcon_password": "",
      "rcon_password_env": "MC_RCON_5",
      "online_mode": false,
      "tps_command": "spark tps",
      "players_command": "list",
      "tps_source": "auto",
      "spark_file": ".astrbot-spark-tps.txt",
      "tps_mode": "spark"
    }
  ],
  "groups": [
    {
      "__template_key": "group",
      "id": "group1",
      "platform_id": "YOUR_PLATFORM_INSTANCE_ID",
      "group_id": "111111111,111111112",
      "server_ids": [
        "server1",
        "server2",
        "server3"
      ],
      "admin_ids": [
        "123456789"
      ],
      "max_entries_per_user": 1,
      "broadcast_origin": ""
    },
    {
      "__template_key": "group",
      "id": "group2",
      "platform_id": "YOUR_PLATFORM_INSTANCE_ID",
      "group_id": "222222222",
      "server_ids": [
        "server3",
        "server4",
        "server5"
      ],
      "admin_ids": [
        "987654321"
      ],
      "max_entries_per_user": 1,
      "broadcast_origin": ""
    }
  ],
  "page_size": 10,
  "sync_interval": 30,
  "rcon_timeout": 5,
  "restart_timeout": 180,
  "poll_interval": 3,
  "game_broadcast": true,
  "commands": {
    "prefix": "mc",
    "help": "帮助,help",
    "add": "添加,add",
    "list": "查看,list",
    "remove": "移除,删除,remove",
    "modify": "修改,edit",
    "players": "玩家,players",
    "tps": "tps",
    "status": "状态,status",
    "servers": "服务器,servers",
    "restart": "重启,restart",
    "logs": "日志,logs",
    "sync": "同步,sync",
    "import": "导入,import",
    "diagnose": "诊断,diagnose",
    "backup": "备份,backup",
    "cancel": "取消重启,cancel",
    "requests": "申请,requests",
    "approve": "通过,approve",
    "reject": "拒绝,reject",
    "mine": "我的,mine"
  },
  "messages": {
    "help": "Minecraft 管理菜单\n{prefix} {add} <玩家名>：添加自己的白名单\n{prefix} {list} [页码]：查看固定编号的白名单\n{prefix} {remove} <编号或玩家名>：移除自己的条目\n{prefix} {modify} <编号或玩家名> <新玩家名>：修改自己的条目\n{prefix} {players} [服务器]：查看在线玩家\n{prefix} {tps} [服务器]：查询 TPS\n{prefix} {status} [服务器]：查看状态\n{prefix} {servers}：查看本群服务器\n{prefix} {restart} <服务器或 all>：重启（管理员）\n{prefix} {logs} [页码]：操作日志（管理员）\n{prefix} {sync}：重试同步（管理员）\n{prefix} {import}：合并导入现有白名单（管理员）\n{prefix} {mine}：查看自己的条目\n{prefix} {diagnose} [服务器]：诊断（管理员）\n{prefix} {requests}：查看待审核申请\n{prefix} {approve} <申请编号>：通过申请（管理员）\n{prefix} {reject} <申请编号> [原因]：拒绝申请（管理员）\n{prefix} {cancel} <服务器>：取消倒计时（重启管理员）\n{prefix} {backup}：创建插件备份（全局管理员）",
    "added": "已添加 #{id} {player}，所属用户：{user}\n{sync}",
    "removed": "已移除 #{id} {player}\n{sync}",
    "modified": "已修改 #{id} {old_player} → {player}\n{sync}",
    "list": "本群白名单（第 {page}/{pages} 页，共 {total} 条）\n{entries}",
    "entry": "#{id} {player} · 所属：{owner}",
    "players": "[{server}] 在线玩家：{result}",
    "tps": "[{server}] spark 性能\nTPS（5秒 / 10秒 / 1分钟 / 5分钟 / 15分钟）：\n{tps_5s} / {tps_10s} / {tps_1m} / {tps_5m} / {tps_15m}\nTick 耗时（毫秒，最小 / 中位数 / P95 / 最大）：\n最近10秒：{mspt_10s_min} / {mspt_10s_med} / {mspt_10s_p95} / {mspt_10s_max}\n最近1分钟：{mspt_1m_min} / {mspt_1m_med} / {mspt_1m_p95} / {mspt_1m_max}\nCPU（单位%，10秒 / 1分钟 / 15分钟）：\n系统：{cpu_system_10s} / {cpu_system_1m} / {cpu_system_15m}\nMC进程：{cpu_process_10s} / {cpu_process_1m} / {cpu_process_15m}{tps_warning}",
    "status": "[{server}] {result}",
    "servers": "本群服务器：\n{entries}",
    "error": "MC 操作失败：{error}",
    "logs": "本群操作日志（第 {page}/{pages} 页，共 {total} 条）\n{entries}",
    "log_entry": "{time} | {action} | 群 {group} | 用户 {user} | {player} | {detail}",
    "sync": "{sync}",
    "import": "已导入 {count} 条未托管条目（无归属，限管理员管理）。\n{sync}",
    "restart_started": "正在重启 {servers}，将向本群广播结果。",
    "restart_success": "✅ {server} 重启成功，耗时 {seconds} 秒。{detail}",
    "restart_failed": "❌ {server} 重启失败：{error}",
    "game_restart_success": "服务器 {server} 已重启成功。",
    "tps_warning": "\n部分 spark 数据不可用：{tps_missing_fields}\n原始输出：\n{tps_raw}",
    "tps_error": "[{server}] spark TPS 查询失败或无法解析：\n{tps_raw}",
    "restart_countdown": "⏳ {server} 将在 {seconds} 秒后重启，请及时保存进度。",
    "restart_cancelled": "已取消 {server} 的重启倒计时。",
    "request_created": "白名单申请 #{id} 已提交：{player}，等待管理员审核。",
    "request_approved": "已通过申请 #{id}：{player}\n{sync}",
    "request_rejected": "已拒绝申请 #{id}：{detail}",
    "alert": "⚠️ [{server}] {alert_type}：{alert_detail}",
    "alert_recovery": "✅ [{server}] {alert_type} 已恢复：{alert_detail}",
    "diagnostics": "MC 诊断\n{result}",
    "requests": "待审核申请\n{entries}",
    "backup_created": "已创建插件数据备份：{result}\n请在管理网页下载，备份包含配置凭据。"
  },
  "tps_missing_value": "暂无数据",
  "spark_file_max_age": 10
}
