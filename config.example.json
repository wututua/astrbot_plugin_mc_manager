      "__template_key": "server",
      "id": "server1",
      "name": "服务器 1",
      "directory": "server1",
      "rcon_host": "127.0.0.1",
      "rcon_port": 25575,
      "rcon_password": "",
      "rcon_password_env": "MC_RCON_1",
      "online_mode": false,
      "tps_command": "spark tps",
      "players_command": "list",
      "tps_source": "auto",
      "spark_file": ".astrbot-spark-tps.txt",
      "tps_mode": "spark"
    },
    {
      "__template_key": "server",
      "id": "server2",
